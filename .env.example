# Public runtime configuration
PREFLIGHT_API_BASE=https://preflight.example.workers.dev
RUNTIME_CANARY_URL=https://preflight.example.workers.dev/runtime-canary

# Webflow Hybrid App OAuth
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_OAUTH_REDIRECT_URI=https://preflight.example.workers.dev/v1/oauth/webflow/callback
WEBFLOW_TOKEN_ENCRYPTION_KEY=

# Server-owned runtime execution
E2B_API_KEY=
E2B_RUNTIME_TEMPLATE_NAME=app-review-runtime
E2B_RUNTIME_TEMPLATE_ID=app-review-runtime:immutable-build-id
E2B_COORDINATOR_TOKEN=

# Reviewer and governance boundaries
REVIEWER_USER_IDS=
PATTERN_COORDINATOR_TOKEN=
GOVERNANCE_APPROVER_TOKEN=

# Local development only
PREFLIGHT_DEV_TOKEN=test-token
PREFLIGHT_REVIEWER_DEV_TOKEN=reviewer-test-token
